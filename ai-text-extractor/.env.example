# Copy to .env and fill in. Any OpenAI-compatible server works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Examples:
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<provider/model>
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=llama3.1   (no key needed)
