# Cloudflare Pages: security and caching headers (ignored by GitHub Pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'

/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
